[0.434, "o", "NAME:\r\n"]
[0.000, "o", "   hexlet-path-size - print size of a file or directory\r\n\r\nUSAGE:\r\n"]
[0.000, "o", "   hexlet-path-size [global options]\r\n\r\nGLOBAL OPTIONS:\r\n"]
[0.000, "o", "   --recursive, -r  recursive size of directories (default: false)\r\n   --human, -H      human-readable sizes (auto-select unit) (default: false)\r\n   --all, -a        include hidden files and directories (default: false)\r\n   --help, -h       show help\r\n"]
